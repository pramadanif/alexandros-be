# ===========================================
# ALEXANDROS Manager Agent Configuration
# ===========================================

# Chain Configuration
CHAIN_ID=1
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Envio GraphQL Endpoint (MANDATORY - single source of truth)
ENVIO_GRAPHQL_ENDPOINT=https://indexer.envio.dev/v1/graphql
ENVIO_API_KEY=

# Smart Contract Addresses
ERC8004_REGISTRY_ADDRESS=0x...
EIP7702_PERMISSION_MANAGER_ADDRESS=0x...
ALEXANDROS_CORE_ADDRESS=0x...

# Manager Agent Configuration
MANAGER_AGENT_ADDRESS=0x...
MANAGER_PRIVATE_KEY=

# Execution Loop Configuration
EVALUATION_INTERVAL_MS=30000
MAX_AGENTS_PER_CYCLE=50
LOOP_TIMEOUT_MS=60000

# Policy Thresholds
ROI_REVOKE_THRESHOLD=-0.03
ROI_EXTEND_THRESHOLD=0.05
GAS_EFFICIENCY_MIN=0.7
SUCCESS_RATE_MIN=0.9
MAX_INACTIVITY_SECONDS=604800

# Safety Configuration
ENVIO_UNAVAILABLE_FREEZE=true
REGISTRY_UNREACHABLE_REVOKE=true
MAX_PERMISSION_DURATION_SECONDS=2592000

# Audit Log Configuration
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_MAX_SIZE=10485760
AUDIT_LOG_MAX_FILES=10
